    {
      "auth": {
        "bodyField": "apikey",
        "secretFormat": "key",
        "style": "body"
      },
      "authKind": "apiKey",
      "baseUrl": "https://compass.transight.in/external/api/v2",
      "deviceIdHint": "IMEI or vehicle ID",
      "deviceIdLabel": "IMEI / Vehicle ID",
      "deviceMatching": "strict",
      "displayName": "Transight",
      "fields": {
        "displayName": "vehicle",
        "falseValues": [
          "off",
          "false",
          "0"
        ],
        "id": "vehicle",
        "ignition": "ignition",
        "imei": "imei",
        "lastUpdated": "time",
        "latitude": "lat",
        "longitude": "lon",
        "speed": "speed",
        "trueValues": [
          "on",
          "true",
          "1"
        ]
      },
      "fleet": {
        "body": {
          "apikey": "{secret}",
          "split_latlng": "True"
        },
        "method": "POST",
        "path": "/get_all_vehicles_last_data/"
      },
      "genericCompatible": true,
      "history": {
        "body": {
          "apikey": "{secret}",
          "fromdate": "{from}",
          "todate": "{to}",
          "vehicle_id": "{deviceId}"
        },
        "method": "POST",
        "path": "/get_vehicle_details/"
      },
      "historyDeviceParam": {
        "imeiParam": "imei",
        "vehicleIdParam": "vehicle_id"
      },
      "key": "transight",
      "listPath": "data",
      "locationField": "location",
      "minPollIntervalSeconds": 60,
      "overrideBuiltin": false,
      "rateLimitNote": "Rate limits: 100/day fleet list, 500/day last data, 10/day history per vehicle.",
      "secretHint": "Your Transight API key",
      "secretLabel": "API Key",
      "successCheck": {
        "equals": 1,
        "field": "status"
      },
      "supportsHistory": true,
      "timeoutSeconds": 30,
      "verified": true
    },
